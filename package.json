{
  "name": "c-elegans-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3017",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "data:build": "node scripts/convert.mjs",
